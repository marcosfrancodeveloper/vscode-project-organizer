{
  "name": "project-organizer",
  "displayName": "Project Organizer",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "marcosfranco",
  "license": "GPL-3.0-or-later",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosfrancodeveloper/vscode-project-organizer.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "tags": [
    "folder",
    "git",
    "manage",
    "project",
    "workspace",
    "switch"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-organizer-container",
          "title": "%viewsContainers.title%",
          "icon": "resources/project-organizer-activity.svg"
        }
      ]
    },
    "views": {
      "project-organizer-container": [
        {
          "id": "projectOrganizer.projectsView",
          "name": "%views.projects.name%",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "projectOrganizer.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "projectOrganizer.addProject",
        "title": "%command.addProject%"
      },
      {
        "command": "projectOrganizer.addProjectFolder",
        "title": "%command.addProjectFolder%"
      },
      {
        "command": "projectOrganizer.removeProject",
        "title": "%command.removeProject%",
        "icon": "$(trash)"
      },
      {
        "command": "projectOrganizer.renameProject",
        "title": "%command.renameProject%",
        "icon": "$(edit)"
      },
      {
        "command": "projectOrganizer.scanProjects",
        "title": "%command.scanProjects%",
        "icon": "$(search)"
      },
      {
        "command": "projectOrganizer.searchProject",
        "title": "%command.searchProject%",
        "icon": "$(list-filter)"
      },
      {
        "command": "projectOrganizer.openProject",
        "title": "%command.openProject%"
      },
      {
        "command": "projectOrganizer.openProjectInNewWindow",
        "title": "%command.openProjectInNewWindow%",
        "icon": "$(link-external)"
      },
      {
        "command": "projectOrganizer.openTerminal",
        "title": "%command.openTerminal%"
      },
      {
        "command": "projectOrganizer.revealInFinder",
        "title": "%command.revealInFinder%"
      },
      {
        "command": "projectOrganizer.editProjectsJson",
        "title": "%command.editProjectsJson%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "projectOrganizer.expandAll",
        "title": "%command.expandAll%",
        "icon": "$(list-tree)"
      },
      {
        "command": "projectOrganizer.collapseAll",
        "title": "%command.collapseAll%",
        "icon": "$(collapse-all)"
      },
      {
        "command": "projectOrganizer.importProjectManager",
        "title": "%command.importProjectManager%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "projectOrganizer.favoriteProject",
        "title": "%command.favoriteProject%",
        "icon": "$(star-empty)"
      },
      {
        "command": "projectOrganizer.unfavoriteProject",
        "title": "%command.unfavoriteProject%",
        "icon": "$(star-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectOrganizer.scanProjects",
          "when": "view == projectOrganizer.projectsView",
          "group": "secondary@1"
        },
        {
          "command": "projectOrganizer.editProjectsJson",
          "when": "view == projectOrganizer.projectsView",
          "group": "secondary@2"
        },
        {
          "command": "projectOrganizer.importProjectManager",
          "when": "view == projectOrganizer.projectsView",
          "group": "secondary@3"
        }
      ],
      "view/item/context": [
        {
          "command": "projectOrganizer.favoriteProject",
          "when": "viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "projectOrganizer.unfavoriteProject",
          "when": "viewItem == project-favorite",
          "group": "inline@1"
        },
        {
          "command": "projectOrganizer.openProjectInNewWindow",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "inline@2"
        },
        {
          "command": "projectOrganizer.refresh",
          "when": "viewItem == root",
          "group": "inline@1"
        },
        {
          "command": "projectOrganizer.searchProject",
          "when": "viewItem == root",
          "group": "inline@2"
        },
        {
          "command": "projectOrganizer.expandAll",
          "when": "viewItem == root",
          "group": "inline@3"
        },
        {
          "command": "projectOrganizer.collapseAll",
          "when": "viewItem == root",
          "group": "inline@4"
        },
        {
          "command": "projectOrganizer.scanProjects",
          "when": "viewItem == root",
          "group": "1_run@1"
        },
        {
          "command": "projectOrganizer.editProjectsJson",
          "when": "viewItem == root",
          "group": "1_run@2"
        },
        {
          "command": "projectOrganizer.importProjectManager",
          "when": "viewItem == root",
          "group": "1_run@3"
        },
        {
          "command": "projectOrganizer.openProject",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "1_open@1"
        },
        {
          "command": "projectOrganizer.openProjectInNewWindow",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "1_open@2"
        },
        {
          "command": "projectOrganizer.favoriteProject",
          "when": "viewItem == project",
          "group": "1_modification@1"
        },
        {
          "command": "projectOrganizer.unfavoriteProject",
          "when": "viewItem == project-favorite",
          "group": "1_modification@1"
        },
        {
          "command": "projectOrganizer.renameProject",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "1_modification@2"
        },
        {
          "command": "projectOrganizer.removeProject",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "1_modification@3"
        },
        {
          "command": "projectOrganizer.openTerminal",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "2_actions@1"
        },
        {
          "command": "projectOrganizer.revealInFinder",
          "when": "viewItem == project || viewItem == project-favorite",
          "group": "2_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "Project Organizer",
      "properties": {
        "projectOrganizer.scanPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.scanPaths.description%"
        },
        "projectOrganizer.scanDepth": {
          "type": "integer",
          "default": 3,
          "description": "%config.scanDepth.description%"
        },
        "projectOrganizer.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "dist",
            "out",
            "bin",
            "obj",
            ".git",
            "vendor",
            "tmp"
          ],
          "description": "%config.ignoredFolders.description%"
        },
        "projectOrganizer.gitStatusEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.gitStatusEnabled.description%"
        },
        "projectOrganizer.gitStatusInterval": {
          "type": "integer",
          "default": 15000,
          "description": "%config.gitStatusInterval.description%"
        },
        "projectOrganizer.customProjectsFile": {
          "type": "string",
          "default": "",
          "description": "%config.customProjectsFile.description%"
        },
        "projectOrganizer.treeExpanded": {
          "type": "boolean",
          "default": false,
          "description": "%config.treeExpanded.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx @vscode/vsce package -o project-organizer.vsix",
    "publish": "npx @vscode/vsce publish",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^18.15.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.19.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.2"
  }
}
